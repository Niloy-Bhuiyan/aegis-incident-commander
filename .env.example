# ---- Aegis configuration (copy to .env and fill in) ----

# Database. SQLite is the zero-dependency local default.
# Production example: postgresql+asyncpg://aegis:password@localhost:5432/aegis
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# LLM provider. Leave ANTHROPIC_API_KEY unset to run the deterministic
# offline provider (no network, lower reasoning quality, used by CI).
ANTHROPIC_API_KEY=
AEGIS_LLM_MODEL=claude-opus-5
AEGIS_LLM_EFFORT=medium

# Optional dense-embedding provider for RAG. Unset => local hashed TF-IDF
# embedder (deterministic, no network). See README "RAG" for the tradeoff.
VOYAGE_API_KEY=
AEGIS_EMBEDDING_MODEL=voyage-3.5-lite

# API auth. Any request that mutates state must send: X-Aegis-Token: <this>
AEGIS_API_TOKEN=dev-local-token

# CORS origins for the frontend (comma-separated)
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulator tick interval in seconds
AEGIS_TICK_SECONDS=2.0

# OpenTelemetry (optional). Unset endpoint => spans stay in-process only.
AEGIS_OTLP_ENDPOINT=
AEGIS_SERVICE_NAME=aegis-backend
